# LabLens Environment Variables
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="LabLens"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretlablenskeyforjwttokengenerationshouldbechangedinproduction"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (defaults to local SQLite for instant zero-config dev, or PostgreSQL)
DATABASE_URL="sqlite:///./lablens.db"
# DATABASE_URL="postgresql://lablens_user:lablens_password@localhost:5432/lablens_db"

# Storage
STORAGE_DIR="./uploads"
MAX_UPLOAD_SIZE_BYTES=15728640

# Gemini AI Configuration
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_ENABLED=true
USE_LOCAL_LLM_FALLBACK=true
